{
  "name": "blink-cms-static",
  "version": "1.0.0",
  "private": true,
  "description": "Blink CMS one-page site — plain HTML, CSS and JavaScript. No framework, no runtime dependencies.",
  "scripts": {
    "start": "node server.js",
    "css": "sass scss/main.scss css/styles.css --load-path=node_modules --no-source-map",
    "css:watch": "npm run css -- --watch"
  },
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "sass": "^1.105.0"
  }
}
